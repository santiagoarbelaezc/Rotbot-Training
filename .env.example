# ==========================================
# Rotbot Training Environment Configuration
# ==========================================

# Google AI Studio / Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional / Alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Optional / Alternative)
GROQ_API_KEY=your_groq_api_key_here

# MySQL Database Connection (Optional if loading directly from DB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=rotbot_db

# Fine-Tuning Artifacts / Model Identifiers
TUNED_MODEL_ID=
